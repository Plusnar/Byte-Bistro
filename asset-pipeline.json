{
  "$comment": "Inputs of `npm run assets:optimize`. Originals are never modified; optimized copies go to `optimized/<source path>` and the game picks them up through src/core/assets/assetRegistry.ts. See docs/PERFORMANCE_ARCHITECTURE.md.",
  "outputDir": "optimized",
  "minSavingsRatio": 0.05,
  "profiles": {
    "character": {
      "$comment": "Skinned cooks and robots. Bones, hair chains and node names are read by code (hairPhysics, armPose), so the hierarchy is untouched and positions stay float: only textures shrink. The cooks are ~100 px tall in the kitchen and at most ~half the screen in the menu.",
      "maxTextureSize": 1024,
      "textureFormat": "webp",
      "textureQuality": 90,
      "meshopt": false,
      "flattenAndJoin": false
    },
    "animation": {
      "$comment": "Clip packs: only their animations are used (retargeted by bone name). No meshopt: its quantization splits the pack's one shared skin into one skin per mesh (6 skeletons in Babylon), which the validation rejects. Measured 2026-10-15.",
      "maxTextureSize": 1024,
      "textureFormat": "webp",
      "textureQuality": 90,
      "meshopt": false,
      "flattenAndJoin": false
    },
    "staticProp": {
      "$comment": "Props that never animate internally and are never looked up by node name: parts sharing a material are joined into one mesh (fewer draw calls), geometry is meshopt-compressed.",
      "maxTextureSize": 1024,
      "textureFormat": "webp",
      "textureQuality": 90,
      "meshopt": true,
      "flattenAndJoin": true
    },
    "prop": {
      "$comment": "Moving props whose node structure is kept (disasters).",
      "maxTextureSize": 1024,
      "textureFormat": "webp",
      "textureQuality": 90,
      "meshopt": true,
      "flattenAndJoin": false
    },
    "staticScene": {
      "$comment": "Backdrops and dioramas. Node names are read (the level map places its stars on named landmarks), so no flatten/join.",
      "maxTextureSize": 2048,
      "textureFormat": "webp",
      "textureQuality": 90,
      "meshopt": true,
      "flattenAndJoin": false
    }
  },
