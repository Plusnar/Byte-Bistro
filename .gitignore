# Allow-list: only what the game needs to build and run is published.
# Everything else (Blender sources, raw asset packs, design documents, logs, tests,
# local tooling) stays on the author's machine.

/*

# Build and run
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/src/
!/public/
!/functions/
# Multiplayer Worker (rooms, Durable Objects) and the phone controller page
!/workers/
!/controller.html
# Dev/preview middleware imported by vite.config.ts
!/server/
# REST API (Model / DAO); the local database and the delivered documentation stay out
!/api/
/api/data/
/api/docs/

# Asset pipeline output and performance gates: `npm run build` needs all of these
# (the registry imports optimized/, vite.config.ts and prebuild run the scripts).
!/optimized/
!/asset-pipeline.json
!/performance-budget.json
!/scripts/
/scripts/*
!/scripts/assets/
!/scripts/build/
!/scripts/perf/

# Models the code imports from outside src/ and public/
!/Scenario/
/Scenario/*
!/Scenario/sao_bento_do_sul.glb
!/Anim/
/Anim/*
!/Anim/Animations/
/Anim/Animations/*
!/Anim/Animations/gltf/
/Anim/Animations/gltf/*
!/Anim/Animations/gltf/Rig_Medium/
/Anim/Animations/gltf/Rig_Medium/*
!/Anim/Animations/gltf/Rig_Medium/Rig_Medium_General.glb
!/Anim/Animations/gltf/Rig_Medium/Rig_Medium_MovementBasic.glb
!/Anim/Animations/gltf/Rig_Medium/Rig_Medium_Simulation.glb
!/Anim/Mannequin Character/
/Anim/Mannequin Character/*
!/Anim/Mannequin Character/characters/
/Anim/Mannequin Character/characters/*
!/Anim/Mannequin Character/characters/Mannequin_Medium.glb

# Repository page
!/README.md
!/README.en.md
!/LICENSE
!/.gitignore
!/.gitattributes
!/docs/
/docs/*
!/docs/images/

# Never published, wherever they appear
*.md
!/README.md
!/README.en.md
__tests__/
*.test.ts
*.test.mjs
# Except the REST API's own guide and tests: they are part of its delivered sources
!/api/README.md
!/api/test/*.test.mjs
.env*
*.log
node_modules/
dist/

!/.env.example

# Regression coverage for Pages video range responses.
!/src/ui/__tests__/
/src/ui/__tests__/*
!/src/ui/__tests__/cinematicRange.test.mjs

!/src/ui/__tests__/mapRoute.test.mjs

# Room Worker: local wrangler state and its tests stay out, like every other test.
/workers/mp/.wrangler/
/workers/mp/test/
/workers/accounts/.wrangler/
/workers/accounts/test/
