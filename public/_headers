# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# See docs/PERFORMANCE_ARCHITECTURE.md, "Cache and distribution".

# Vite output: every file name carries its content hash, so it never changes in place.
/bundle/*
  Cache-Control: public, max-age=31536000, immutable

# Third-party decoders copied by the asset pipeline, version in the file name.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Versioned cinematic files can be reused across menu visits and deployments.
/assets/ui/cinematic/chase-landscape-hq-v1.mp4
  Cache-Control: public, max-age=31536000, immutable
/assets/ui/cinematic/chase-landscape-hq-v1.webm
  Cache-Control: public, max-age=31536000, immutable
/assets/ui/cinematic/chase-portrait-hq-v1.mp4
  Cache-Control: public, max-age=31536000, immutable
/assets/ui/cinematic/chase-portrait-hq-v1.webm
  Cache-Control: public, max-age=31536000, immutable

# Must always be fresh: they name everything else.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# The phone controller page: always fresh, never framed by another site.
/controller
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
/controller.html
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
/asset-manifest.json
  Cache-Control: no-cache
