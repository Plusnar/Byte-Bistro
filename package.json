{
  "name": "byte-bistro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:scenario": "node scripts/embed-scenario-glb-textures.mjs",
    "dev": "vite",
    "api": "node --disable-warning=ExperimentalWarning api/server.mjs",
    "test:api": "vitest run api",
    "prebuild": "npm run check:perf",
    "build": "tsc -b && vite build && node scripts/perf/check-bundle-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:library": "node scripts/prepare-asset-library.mjs",
    "assets:optimize": "node scripts/assets/optimize-assets.mjs",
    "assets:check": "node scripts/assets/optimize-assets.mjs --check && node scripts/assets/validate-assets.mjs",
    "assets:compare": "node scripts/assets/compare-textures.mjs",
    "check:perf": "node scripts/perf/check-perf-rules.mjs && npm run assets:check",
    "perf:bench": "node scripts/perf/run-perf.mjs",
    "verify": "npm run check:perf && npm test && npm run build"
  },
  "dependencies": {
    "@babylonjs/core": "^8.21.0",
    "@babylonjs/loaders": "^8.21.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "license": "UNLICENSED"
}
